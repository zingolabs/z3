# Zingod configuration: Mainnet (--profile zingod)
#
# - Keys: https://github.com/zingolabs/zingod/blob/v1.2.0/book/src/operators/configuration.md
# - Not for production mainnet use: https://github.com/zingolabs/zingod/blob/v1.2.0/packages/zingod/src/daemon.rs#L80

network = "mainnet"

[[trusted_validators]]
jsonrpc_address = "zebra:8232"
cookie_path = "/var/run/auth/.cookie"

[serve]
tls = "self_signed"
# Own pair: config/mainnet/tls/ → /etc/zingod/tls (https://github.com/zingolabs/zingod/blob/v1.2.0/book/src/operators/docker.md#tls-certificates)
# tls = { cert_path = "/etc/zingod/tls/fullchain.pem", key_path = "/etc/zingod/tls/privkey.pem" }

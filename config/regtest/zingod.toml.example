# Zingod configuration: Regtest (--profile zingod)
#
# - Keys: https://github.com/zingolabs/zingod/blob/v1.2.0/book/src/operators/configuration.md
# - Zebra RPC unauthenticated on regtest (ZEBRA_RPC__ENABLE_COOKIE_AUTH=false, no credentials)

network = "regtest"

[[trusted_validators]]
jsonrpc_address = "zebra:18232"

[serve]
tls = "self_signed"
# Own pair: config/regtest/tls/ → /etc/zingod/tls (https://github.com/zingolabs/zingod/blob/v1.2.0/book/src/operators/docker.md#tls-certificates)
# tls = { cert_path = "/etc/zingod/tls/fullchain.pem", key_path = "/etc/zingod/tls/privkey.pem" }

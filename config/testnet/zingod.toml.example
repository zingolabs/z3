# Zingod configuration: Testnet (--profile zingod)
#
# - Keys: https://github.com/zingolabs/zingod/blob/v1.2.0/book/src/operators/configuration.md

network = "testnet"

[[trusted_validators]]
jsonrpc_address = "zebra:18232"
cookie_path = "/var/run/auth/.cookie"

[serve]
tls = "self_signed"
# Own pair: config/testnet/tls/ → /etc/zingod/tls (https://github.com/zingolabs/zingod/blob/v1.2.0/book/src/operators/docker.md#tls-certificates)
# tls = { cert_path = "/etc/zingod/tls/fullchain.pem", key_path = "/etc/zingod/tls/privkey.pem" }
